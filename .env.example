# Copy to .env and fill in. There is no registration: this is the only account.
ADMIN_USERNAME=admin
# python -c "from secrets import token_urlsafe; print(token_urlsafe(20))"
ADMIN_PASSWORD=change-me
# Signs the session cookie. python -c "from secrets import token_urlsafe; print(token_urlsafe(32))"
SECRET_KEY=change-me

# Optional
# DATA_DIR=data            # folder for maindb.db, audio/ and photos/
# SECURE_COOKIES=false     # set to true when the site is served over HTTPS
